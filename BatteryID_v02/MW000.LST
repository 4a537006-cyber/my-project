  674                     	    ; 1. 讀取並暫存重置旗標 RST_SRF0 RST_SRF1
  675                     	    ; ---------------------------------------------------
  676  0000BC04 AD 15 30    	    LDA RST_SRF0            ; 讀取 RST_SRF0 (0x3015)
  677  0000BC07 85 00       	    STA RAM00               ; 備份到 RAM00 用意:後續 SFR 被清除後查不到死因
  678  0000BC09 AD 16 30    		LDA RST_SRF1            ; 讀取 RST_SRF1 (0x3016)
  679  0000BC0C 85 01       	    STA RAM01               ; 備份到 RAM01 用意:後續 SFR 被清除後查不到死因
  680  0000BC0E             		
  681  0000BC0E A9 5A       		LDA #PWPR_Key           ;解除寫保護機制
  682  0000BC10 8D 0F 30    		STA PWPR
  683  0000BC13 A9 FF       	    LDA #FFh                
  684  0000BC15 8D 15 30    	    STA RST_SRF0            ; 將硬體旗標全部清零
  685  0000BC18             		
  686  0000BC18 A9 5A       		LDA #PWPR_Key           ;解除寫保護機制
  687  0000BC1A 8D 0F 30    		STA PWPR
  688  0000BC1D A9 FF       		LDA #FFh                
  689  0000BC1F 8D 16 30    	    STA RST_SRF1            ; 將硬體旗標全部清零
  690  0000BC22             		
  691  0000BC22             		
  692                     		; ---------------------------------------------------
  693                     	    ; 2. 優先初始化硬體 (為了能馬上使用 UART)
  694                     	    ; ---------------------------------------------------
  695  0000BC22 20 3D C2    	    JSR INIT_IO_PORTS       
  696  0000BC25 20 11 C3    	    JSR INIT_UART
  697                     	    ; ---------------------------------------------------
  698                     	    ; 3. UART 印出重置旗標 (例如 "RST(RAM00)=80\r\n")
  699                     	    ; ---------------------------------------------------
  700                     	    ;JSR PRINT_RST_FLAG
  701                     		; ---------------------------------------------------
  702                     	    ; 4. 逐一判定重置來源 (依優先級)
  703                     	    ; ---------------------------------------------------
  704  0000BC28             	CHECK_POF:
  705  0000BC28 A5 00       	    LDA RAM00
  706  0000BC2A 29 80       	    AND #80h                ; 檢查 Bit 7: POF (Power-On Flag / 上電重置)
  707  0000BC2C D0 34       	    BNE COLD_BOOT_FLOW      ; 若為上電，冷開機
  708  0000BC2E             	CHECK_EXRF:
  709  0000BC2E A5 00       	    LDA RAM00
  710  0000BC30 29 40       	    AND #40h                ; 檢查 Bit 6: EXRF (External Reset / 外部 RST 腳位觸發)
  711  0000BC32 D0 2E       	    BNE COLD_BOOT_FLOW      ; 若為外部手動重置，冷開機
  712  0000BC34             	CHECK_SWRF:
  713  0000BC34 A5 00       	    LDA RAM00
  714  0000BC36 29 20       	    AND #20h                ; 假設 Bit 4 為 SWRF (software Reset / 軟體重置)
  715  0000BC38 D0 0C       	    BNE WARM_BOOT_FLOW      ; 暖開機
  716  0000BC3A             	CHECK_WRF:
  717  0000BC3A A5 00       	    LDA RAM00
  718  0000BC3C 29 10       	    AND #10h                ; 假設 Bit 4 為 WRF (Watchdog Reset / 看門狗超時)
  719  0000BC3E D0 06       	    BNE WARM_BOOT_FLOW      ; 若為超時，暖開機
  720  0000BC40             	CHECK_IARF:
  721  0000BC40 A5 00       	    LDA RAM00
  722  0000BC42 29 08       	    AND #08h                ; 假設 Bit 3 為 IARF (Illegal Address Reset / 非法位址或跑飛)
  723  0000BC44 D0 00       	    BNE WARM_BOOT_FLOW      ; 進入非法指標專屬處理，暖開機
  724                     	
