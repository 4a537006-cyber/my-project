"FCPU_SR"
"FCPU select [ -  -  -  -  -  CKS2  CKS1  CKS0 ]" 
"RLH_EN"
"Release Halt mode enable [ -  -  DIV1X  TM2  TM1  P0  TM0  DIV0X ]" 
"TM0_L"
"Timer0 low byte [ T7  T6  T5  T4  T3  T2  T1  T0 ]" 
"TM0_H"
