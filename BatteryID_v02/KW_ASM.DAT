".ADDR"
"Define word sized data"
".ALIGN"
"Align data to a given boundary"
".AUTOIMPORT"
"When switched on (using a +), undefined symbols are automatically marked as import"
".BLANK"
"Evaluates its argument in braces and yields 'false' if the argument is non blank"
".BYTE"
"Define byte sized data"
".CASE"
"Switch on or off case sensitivity on identifiers"
".CODE"
"Switch to the CODE segment"
".CONCAT"
"Concatenate a list of string constants separated by commas"
".CONST"
"Evaluates its argument in braces and yields 'true' if the argument is a constant expression"
".DATA"
"Switch to the DATA segment"
".DBYT"
"Define word sized data with the hi and lo bytes swapped"
".DEBUGINFO"
"Switch on or off debug info generation"
".DEFINE"
"Start a define style macro definition"
".DEF"
"Yields 'true' if the identifier is a symbol that is already defined"
".DEFINED"
"Yields 'true' if the identifier is a symbol that is already defined"
".DWORD"
"Define dword sized data (4 bytes)"
".ELSE"
"Conditional assembly: Reverse the current condition. "
".ELSEIF"
"Conditional assembly: Reverse current condition and test a new one"
".END"
"Forced end of assembly"
".ENDIF"
"Conditional assembly: Close a .IF... or .ELSE branch"
".ENDMAC"
"End of macro definition"
".ENDMACRO"
"End of macro definition"
".ENDPROC"
"End of local lexical level"
".ENDREP"
"End a .REPEAT block. "
".ENDREPEAT"
"End a .REPEAT block. "
".ERROR"
"Force an assembly error"
".EXITMAC"
"Abort a macro expansion immidiately"
".EXITMACRO"
"Abort a macro expansion immidiately"
".EXPORT"
"Make symbols accessible from other modules"
".EXPORTZP"
"Make symbols accessible from other modules"
".GLOBAL"
"Declare symbols as global"
".GLOBALZP"
"Declare symbols as global"
".IF"
"Conditional assembly: Evalute an expression and switch assembler output on or off"
".IFBLANK"
"Conditional assembly: Check if there are any remaining tokens in this line"
".IFCONST"
"Conditional assembly: Switch assembler output on depending on the constness of the expression"
".IFDEF"
"Conditional assembly: Check if a symbol is defined"
".IFNBLANK"
"Conditional assembly: Check if there are any remaining tokens in this line"
".IFNDEF"
"Conditional assembly: Check if a symbol is defined"
".IFNREF"
"Conditional assembly: Check if a symbol is referenced"
".IFP02"
"Conditional assembly: Check if the assembler is currently in 6502 mode"
".IFPC02"
"Conditional assembly: Check if the assembler is currently in 65C02 mode"
".IFREF"
"Conditional assembly: Check if a symbol is referenced"
".IMPORT"
"Import a symbol from another module"
".IMPORTZP"
"Import a symbol from another module"
".INCBIN"
"Include a file as binary data"
".INCLUDE"
"Include another source file"
".LEFT"
"Extract the left part of a given token list"
".LINECONT"
"Switch on or off line continuations using the backslash character"
".LISTBYTES"
"Set how many bytes are shown in the listing for one source line"
".LOCAL"
"Declare a list of identifiers as local to the macro expansion"
".LOCALCHAR"
"Define the character that start 'cheap' local labels"
".MAC"
"Start a classic macro definition"
".MACRO"
"Start a classic macro definition"
".MATCH"
"Matches two token lists against each other"
".MID"
"Return part of the token list"
".ORG"
"Start a section of absolute code"
".OUT"
"Output a string to the console without producing an error"
".P02"
"Enable the 6502 instruction set"
".PAGELEN, .PAGELENGTH"
"Set the page length for the listing"
".PARAMCOUNT"
"Count the actual number of parameters in the macro invocation"
".PC02"
"Enable the 65C02 instructions set"
".PROC"
"Start a nested lexical level"
".REF"
"Yield 'true' if the identifier is referenced in the source file"
".REFERENCED"
"Yield 'true' if the identifier is referenced in the source file"
".REPEAT"
"Repeat all commands between .REPEAT and .ENDREPEAT constant number of times"
".RELOC"
"Switch back to relocatable mode"
".RES"
"Reserve storage"
".RIGHT"
"Extracts the right part of a given token list"
".RODATA"
"Switch to the RODATA segment"
".SEGMENT"
"Switch to another segment"
".STRAT"
"Return the value of the character at the given position"
".STRING"
"Convert the argument into a string constant"
".STRLEN"
"Evaluate to the length of the string"
".TBLDEF"
"Declare the load object and header size to skip"
".TBLENTRY"
"Insert 3 bytes to refer to load objects"
".TBLSTART"
"Declare the load object table"
".TCOUNT"
"Count the number of tokens given as argument"
".WARNING"
"Force an assembly warning"
".WORD"
"Define word sized data"
".XMATCH"
"Match two token lists against each other"
".ZEROPAGE"
"Switch to the ZEROPAGE segment"
"ADC"
"Add memory to Accumulator with Carry"
"AND"
"'AND' Memory with Accumulator"
"ASL"
"Shift One bit Left"
"BBR"
"Branch on Bit Reset"
"BBS"
"Branch on Bit Set"
"BCC"
"Branch on Carry Clear"
"BCS"
"Branch on Carry Set"
"BEQ"
"Branch on Result Zero"
"BIT"
"Test Memory Bits w/Accumulator"
"BMI"
"Branch on Result Minus"
"BNE"
"Branch on Result Not Zero"
"BPL"
"Branch on Result Plus"
"BRA"
"Branch Always"
"BRK"
"Force Break"
"BVC"
"Branch on Overflow Clear"
"BVS"
"Branch on Overflow Set"
"CLC"
"Clear Carry Flag"
"CLD"
"Clear Decimal Mode"
"CLI"
"Clear Interrupt Disable Bit"
"CLV"
"Clear Overflow Flag"
"CMP"
"Compare Memory and Accumulator"
"CPX"
"Compare Memory and Index X"
"CPY"
"Compare Memory and Index Y"
"DEC"
"Decrement by One"
"DEX"
"Decrement Index X by One"
"DEY"
"Decrement Index Y by One"
"EOR"
"'Exclusive-or' Memory with Accumulator"
"INC"
"Increment by One"
"INX"
"Increment Index X by One"
"INY"
"Increment Index Y by One"
"JMP"
"Jump to New Location"
"JSR"
"Jump to New Location Saving Return Address"
"LDA"
"Load Accumulator with Memory"
"LDX"
"Load Index X with Memory"
"LDY"
"Load Index Y with Memory"
"LSR"
"Shift One Bit Right"
"NOP"
"No Operation"
"ORA"
"'OR' Memory with Accumulator"
"PHA"
"Push Accumulator on Stack"
"PHP"
"Push Processor Status on Stack"
"PHX"
"Push Index X on Stack"
"PHY"
"Push Index Y on Stack"
"PLA"
"Pull Accumulator from Stack"
"PLP"
"Pull Process Status from Stack"
"PLX"
"Pull Index X from Stack"
"PLY"
"Pull Index Y from Stack"
"RMB"
"Reset Memory Bit"
"ROL"
"Rotate One Bit Left"
"RO"
"Rotate One Bit Right"
"RTI"
"Return from Interrupt"
"RTS"
"Return from Subroutine"
"SBC"
"Subtract Memory from Accumulator with Borrow"
"SEC"
"Set Carry Flag"
"SED"
"Set Decimal Mode"
"SEI"
"Set Interrupt Disable Bit"
"SMB"
"Set Memory Bit"
"STA"
"Store Accumulator in Memory"
"STP"
"Stop the Clock"
"STX"
"Store Index X in Memory"
"STY"
"Store Index Y in Memory"
"STZ"
"Store Zero in Memory"
"TAX"
"Transfer Accumulator in Index X"
"TAY"
"Transfer Accumulator in Index Y"
"TRB"
"Test and Reset Memory Bits with Accumulator"
"TSB"
"Test and Set Memory Bits with Accumulator"
"TSX"
"Transfer Stack Pointer to Index X"
"TXA"
"Transfer Index X to Accumulator"
"TXS"
"Transfer Index X to Stack Pointer"
"TYA"
"Transfer Index Y to Accumulator"
"WAI"
"Wait for Interrupt"
"NMI_SEL"
"NMI source select [ -  -  -  -  -  NIS2  NIS1  NIS0 ]" 
"IRQ_EN"
"IRQ enable [ -  -  DIV1X  TM2  TM1  P0  TM0  DIV0X ]" 
"IRQ_ST"
"IRQ status [ -  -  DIV1X  TM2  TM1  P0  TM0  DIV0X ]" 
"IRQ_CLR"
"IRQ clear [ -  -  DIV1X  TM2  TM1  P0  TM0  DIV0X ]" 
"DIV0_ST"
"DIV0 status [ DIV07  DIV06  DIV05  DIV04  DIV03  DIV02  DIV01  DIV00 ]" 
"DIV0X_SEL"
"DIV0X INT select [ -  -  -  -  -  -  CKO1  CKO0 ] (0,0)=Fosc/32, (0,1)=Fosc/64, (1,0)=Fosc/128, (1,1)=Fosc/256" 
"DIV1_STL"
"DIV1 status low byte [ DIV17  DIV16  DIV15  DIV14  DIV13  DIV12  DIV11  DIV10 ]" 
"DIV1_STH"
"DIV1 status high byte [ DIV1F  DIV1E  DIV1D  DIV1C  DIV1B  DIV1A  DIV19  DIV18 ]" 
"DIV1X_SEL"
"DIV1X INT select [ CKI7  CKI6  CKI5  CKI4  CKO3  CKO2  CKO1  CKO0 ]" 
"WDT_CTL"
"Watchdog timer control [ RSTS  -  -  -  -  RSEL  CKI1  CKI0 ]" 
"WDT_CLR"
"WDT RSTS clear [ CLR  -  -  -  Bit3  Bit2  Bit1  Bit0 ]" 
"BANK"
"Bank select [ -  -  -  -  BK3  BK2  BK1  BK0 ]" 
"PWR_CR"
